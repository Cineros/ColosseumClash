generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "cjs"
}


datasource db {
  provider = "postgresql"
}

model CardSet {
  id            String   @id @default(uuid())
  name          String
  cardCount Int @default(200)
  status        String   @default("draft")
  cardsEditable Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  finalizedAt   DateTime?

  cards         Card[]
}


model Card {
  id         String   @id @default(uuid())
  cardNumber Int

  setId      String
  set        CardSet  @relation(fields: [setId], references: [id])

  title       String
  description String?
  artwork String?


  creator     String
  artist      String

  colors String[]
  costs Json

  primaryType String
  tribe       String?
  rarity      String?
  speed       String?

  damage      Int?
  armor       Int?
  health      Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([setId, cardNumber])
}