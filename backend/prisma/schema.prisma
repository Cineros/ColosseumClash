generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  cards Card[]
}

model Card {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  imagePath   String
  createdAt   DateTime @default(now())

  ownerId Int
  owner User @relation(fields: [ownerId], references: [id])
}
